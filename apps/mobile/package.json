{
  "name": "@weave/mobile",
  "version": "0.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.26",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "@weave/design-tokens": "*",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "6.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "@types/jest": "^29.5.14",
    "react-test-renderer": "19.2.3",
    "@testing-library/react-native": "^13.3.3",
    "@weave/typescript-config": "*",
    "@weave/eslint-config": "*"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "expo start",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "build": "expo export --platform ios --platform android",
    "lint": "eslint ."
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.tsx"
    ]
  }
}
