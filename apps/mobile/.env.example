# Public client key only. Supply this environment variable when building native projects.
CLERK_PUBLISHABLE_KEY=
# Register callback/package/bundle identities in the shared Clerk instance.
# Never add CLERK_SECRET_KEY, passwords, tokens, or test credentials here.
# iOS Xcode build settings (public values; not loaded automatically from this file):
WEAVE_CLERK_PUBLISHABLE_KEY=
WEAVE_AUTH_CALLBACK_SCHEME=si.tryweave
WEAVE_AUTH_CALLBACK_URL=si.tryweave://callback
