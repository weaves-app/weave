generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationRequestBudget {
  key           String    @id
  nextAllowedAt DateTime  @db.Timestamptz
  expiresAt     DateTime? @db.Timestamptz

  @@index([expiresAt])
}
