{
  "$schema": "https://aka.ms/codetour-schema",
  "title": "1 · Request → Proxy → Next.js route",
  "description": "A browser or API request matches proxy.config.matcher.",
  "steps": [
    {
      "file": "apps/web/src/proxy.ts",
      "line": 15,
      "title": "proxy",
      "description": "Next.js invokes proxy(request, event); this calls the configuration check.\n\nTransition: Next.js invokes"
    },
    {
      "file": "apps/web/src/features/auth/infrastructure/configuration.ts",
      "line": 4,
      "title": "readClerkConfiguration",
      "description": "Return a configuration object only when both keys exist. Return to proxy().\n\nTransition: returns to proxy"
    },
    {
      "file": "apps/web/src/proxy.ts",
      "line": 6,
      "title": "authenticate",
      "description": "With configuration present, proxy invokes the handler created by clerkMiddleware at module initialization.\n\nTransition: calls handler"
    },
    {
      "file": "apps/web/src/proxy.ts",
      "line": 6,
      "title": "authenticate",
      "description": "The authored Clerk callback returns NextResponse.next(); Clerk supplies request auth context. Next.js resumes route handling.\n\nTransition: framework handoff"
    },
    {
      "title": "Branches and stop conditions",
      "description": "Missing keys: proxy returns NextResponse.next() without invoking authenticate; routes show unavailable or the protected API returns 503.\n\nExcluded paths: matcher skips _next/static, _next/image and favicon.ico. Other public brand paths still match.\n\nThe destination is selected by the URL: /sign-up, /sign-in, /sso-callback, /organizations, /organizations/create, /, or /api/session. These routes are alternatives, not consecutive calls.\n\nlayout.tsx is part of React page rendering; proxy does not call it. Clerk internals can respond before our continuation; this lane describes the normal configured continuation."
    }
  ]
}
